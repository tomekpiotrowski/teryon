{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teryon",
  "identifier": "com.teryon.desktop",
  "build": {
    "frontendDist": "../../app/www",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": { "script": "bun run start", "cwd": "../../app" },
    "beforeBuildCommand": { "script": "bun run build && cargo build --release -p teryon && node ../desktop/scripts/copy-teryon.mjs", "cwd": "../../app" }
  },
  "app": {
    "windows": [
      {
        "title": "Teryon",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/teryon"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
